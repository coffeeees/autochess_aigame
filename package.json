{
  "name": "starlight-onecost-prototype",
  "version": "0.15.18",
  "private": true,
  "description": "PvE autochess prototype with 33 playable units, 40 equipment items and patch notes",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{js,ts,css}\" \"tests/**/*.js\" \"tools/*.{cjs,mjs,js}\" vite.config.js",
    "format:check": "prettier --check \"src/**/*.{js,ts,css}\" \"tests/**/*.js\" \"tools/*.{cjs,mjs,js}\" vite.config.js",
    "baseline:check": "node tools/combat-baseline.mjs --check",
    "typecheck": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "prettier": "3.3.3",
    "typescript": "5.7.3",
    "vite": "6.4.5",
    "vitest": "3.2.6"
  }
}
